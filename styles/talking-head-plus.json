{
  "id": "talking-head-plus",
  "order": 3,
  "name": "Talking Head+",
  "description": "Bold 2-word captions, emphasis punch-ins and a warm orange-teal grade. Energetic but human.",
  "pacing": {
    "max_gap": 0.15,
    "pad_in": 0.05,
    "pad_out": 0.08,
    "remove_fillers": true,
    "speed": 1.0
  },
  "framing": {
    "width": 1080,
    "height": 1920,
    "reframe": "subject"
  },
  "captions": {
    "enabled": true,
    "max_words": 2,
    "max_chars": 12,
    "case": "upper",
    "strip_punctuation": true,
    "font": "Inter",
    "font_style": "Black",
    "size": 0.08,
    "color": "#FFFFFF",
    "accent": "#FFE500",
    "highlight_emphasis": true,
    "outline": {
      "color": "#000000",
      "width": 0.06
    },
    "shadow": {
      "color": "#000000",
      "opacity": 0.5,
      "offset": [
        0.0,
        -0.006
      ],
      "softness": 0.02
    },
    "box": null,
    "position": [
      0.5,
      0.32
    ],
    "animation": "pop_strong",
    "tracking": 1.0,
    "min_frames": 6,
    "hold": 0.25
  },
  "hook": {
    "enabled": true,
    "duration": 2.5,
    "font": "Inter",
    "font_style": "Black",
    "size": 0.07,
    "case": "none",
    "color": "#000000",
    "box": {
      "color": "#FFE500",
      "opacity": 1.0
    },
    "outline": null,
    "position": [
      0.5,
      0.8
    ],
    "animation": "pop",
    "max_chars_per_line": 20
  },
  "zoom": {
    "mode": "auto",
    "on_cuts": 1.15,
    "on_emphasis": 1.18,
    "every": 0.0,
    "max": 1.25
  },
  "ramps": {
    "auto": false
  },
  "effects": {
    "auto": [],
    "max_per_minute": 8
  },
  "masks": {
    "auto": []
  },
  "transitions": {
    "type": "none"
  },
  "grade": {
    "look": "orange-teal",
    "intensity": 0.6,
    "balance": true
  },
  "audio": {
    "normalize": true,
    "target_lufs": -14.0,
    "voice_isolation": false
  },
  "split_edits": {
    "mode": "auto",
    "type": "J",
    "max": 0.2,
    "mid_sentence": "L"
  },
  "broll": {
    "mode": "full",
    "motion": "push_in",
    "push": 1.05,
    "every": 4.0,
    "max": 2.8,
    "max_coverage": 0.45
  }
}
