{
  "id": "shorts",
  "order": 5,
  "name": "Shorts",
  "description": "Built for vertical Shorts: big words, fast pacing.",
  "pacing": {
    "max_gap": 0.12,
    "pad_in": 0.035,
    "pad_out": 0.06,
    "remove_fillers": true,
    "speed": 1.08
  },
  "framing": {
    "width": 1080,
    "height": 1920,
    "reframe": "subject"
  },
  "captions": {
    "enabled": true,
    "max_words": 2,
    "max_chars": 14,
    "case": "upper",
    "strip_punctuation": true,
    "font": "Inter",
    "font_style": "Black",
    "size": 0.09,
    "color": "#FFFFFF",
    "accent": "#3DFF7A",
    "highlight_emphasis": true,
    "outline": {
      "color": "#000000",
      "width": 0.1
    },
    "shadow": {
      "color": "#000000",
      "opacity": 0.5,
      "offset": [
        0.0,
        -0.006
      ],
      "softness": 0.02
    },
    "box": null,
    "position": [
      0.5,
      0.42
    ],
    "animation": "pop_strong",
    "tracking": 1.0,
    "min_frames": 6,
    "hold": 0.25
  },
  "hook": {
    "enabled": true,
    "duration": 2.5,
    "font": "Inter",
    "font_style": "Black",
    "size": 0.075,
    "case": "none",
    "color": "#000000",
    "box": {
      "color": "#FFFFFF",
      "opacity": 1.0
    },
    "outline": null,
    "position": [
      0.5,
      0.74
    ],
    "animation": "pop",
    "max_chars_per_line": 18
  },
  "zoom": {
    "mode": "auto",
    "on_cuts": 1.18,
    "on_emphasis": 1.3,
    "every": 3.0,
    "max": 1.4
  },
  "ramps": {
    "auto": false
  },
  "effects": {
    "auto": [
      "flash@hook_end",
      "shake@emphasis"
    ],
    "max_per_minute": 10
  },
  "masks": {
    "auto": []
  },
  "transitions": {
    "type": "none"
  },
  "grade": {
    "look": "natural",
    "intensity": 0.9,
    "balance": true
  },
  "audio": {
    "normalize": true,
    "target_lufs": -14.0,
    "voice_isolation": false
  },
  "split_edits": {
    "mode": "none",
    "type": "J",
    "max": 0.12
  },
  "broll": {
    "mode": "full",
    "motion": "push_in",
    "push": 1.1,
    "every": 3.5,
    "max": 2.2,
    "max_coverage": 0.5
  }
}
