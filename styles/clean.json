{
  "id": "clean",
  "order": 1,
  "name": "Clean",
  "description": "One word at a time, small lower-case type, no zooms or effects.",
  "pacing": {
    "max_gap": 0.25,
    "pad_in": 0.06,
    "pad_out": 0.1,
    "remove_fillers": true,
    "speed": 1.0
  },
  "framing": {
    "width": 1080,
    "height": 1920,
    "reframe": "subject"
  },
  "captions": {
    "enabled": true,
    "max_words": 1,
    "max_chars": 14,
    "case": "lower",
    "strip_punctuation": true,
    "font": "Inter",
    "font_style": "Medium",
    "size": 0.058,
    "color": "#FFFFFF",
    "accent": null,
    "highlight_emphasis": false,
    "outline": null,
    "shadow": {
      "color": "#000000",
      "opacity": 0.55,
      "offset": [
        0.0,
        -0.004
      ],
      "softness": 0.07
    },
    "box": null,
    "position": [
      0.5,
      0.33
    ],
    "animation": "fade",
    "tracking": 1.0,
    "min_frames": 8,
    "hold": 0.3
  },
  "hook": {
    "enabled": false,
    "duration": 2.5,
    "font": "Inter",
    "font_style": "Medium",
    "size": 0.07,
    "case": "lower",
    "color": "#FFFFFF",
    "box": null,
    "outline": null,
    "position": [
      0.5,
      0.8
    ],
    "animation": "pop",
    "max_chars_per_line": 20
  },
  "zoom": {
    "mode": "none"
  },
  "ramps": {
    "auto": false
  },
  "effects": {
    "auto": []
  },
  "masks": {
    "auto": []
  },
  "transitions": {
    "type": "none"
  },
  "grade": {
    "look": "natural",
    "intensity": 0.6,
    "balance": true
  },
  "audio": {
    "normalize": true,
    "target_lufs": -14.0,
    "voice_isolation": false
  },
  "split_edits": {
    "mode": "none",
    "type": "J",
    "max": 0.15
  },
  "broll": {
    "mode": "full",
    "motion": "none",
    "every": 6.0,
    "max": 3.0,
    "max_coverage": 0.3
  }
}
