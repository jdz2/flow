{
  "id": "business",
  "order": 4,
  "name": "Business",
  "description": "Boxed sentence-case captions, subtle punch-ins, natural grade. For brands.",
  "pacing": {
    "max_gap": 0.3,
    "pad_in": 0.07,
    "pad_out": 0.12,
    "remove_fillers": true,
    "speed": 1.0
  },
  "framing": {
    "width": 1080,
    "height": 1920,
    "reframe": "subject"
  },
  "captions": {
    "enabled": true,
    "max_words": 5,
    "max_chars": 30,
    "case": "none",
    "strip_punctuation": true,
    "font": "Inter",
    "font_style": "SemiBold",
    "size": 0.048,
    "color": "#111111",
    "accent": "#2F6BFF",
    "highlight_emphasis": true,
    "outline": null,
    "shadow": null,
    "box": {
      "color": "#FFFFFF",
      "opacity": 0.92
    },
    "position": [
      0.5,
      0.28
    ],
    "animation": "fade",
    "tracking": 1.0,
    "min_frames": 6,
    "hold": 0.25
  },
  "hook": {
    "enabled": true,
    "duration": 2.5,
    "font": "Inter",
    "font_style": "Bold",
    "size": 0.07,
    "case": "none",
    "color": "#FFFFFF",
    "box": {
      "color": "#2459E0",
      "opacity": 1.0
    },
    "outline": null,
    "position": [
      0.5,
      0.8
    ],
    "animation": "pop",
    "max_chars_per_line": 20
  },
  "zoom": {
    "mode": "auto",
    "on_cuts": 1.07,
    "on_emphasis": 0.0,
    "every": 0.0,
    "max": 1.15
  },
  "ramps": {
    "auto": false
  },
  "effects": {
    "auto": []
  },
  "masks": {
    "auto": []
  },
  "transitions": {
    "type": "none"
  },
  "grade": {
    "look": "natural",
    "intensity": 0.8,
    "balance": true
  },
  "audio": {
    "normalize": true,
    "target_lufs": -14.0,
    "voice_isolation": false
  },
  "split_edits": {
    "mode": "auto",
    "type": "J",
    "max": 0.25
  },
  "broll": {
    "mode": "full",
    "motion": "push_in",
    "push": 1.04,
    "every": 6.0,
    "max": 4.0,
    "max_coverage": 0.35,
    "fade": 4
  }
}
